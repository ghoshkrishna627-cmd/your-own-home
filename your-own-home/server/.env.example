# ============================================
# SERVER
# ============================================
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# ============================================
# DATABASE (MongoDB Atlas)
# YOU NEED TO DO THIS: create a free cluster at https://www.mongodb.com/cloud/atlas
# Get the connection string from Atlas -> Database -> Connect -> Drivers
# ============================================
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/your-own-home?retryWrites=true&w=majority

# ============================================
# JWT
# Generate strong random secrets, e.g.: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# ============================================
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# ============================================
# GOOGLE OAUTH
# YOU NEED TO DO THIS: https://console.cloud.google.com/apis/credentials
# Create OAuth Client ID (Web application)
# Authorized redirect URI: http://localhost:5000/api/auth/google/callback
# ============================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# ============================================
# FACEBOOK OAUTH (optional)
# YOU NEED TO DO THIS: https://developers.facebook.com/apps
# ============================================
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_CALLBACK_URL=http://localhost:5000/api/auth/facebook/callback

# ============================================
# CLOUDINARY
# YOU NEED TO DO THIS: https://cloudinary.com/users/register/free
# Dashboard shows Cloud Name / API Key / API Secret
# ============================================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ============================================
# STRIPE (use TEST mode keys for development)
# YOU NEED TO DO THIS: https://dashboard.stripe.com/register
# Get keys from Developers -> API Keys (use "Test mode" toggle)
# Webhook secret comes from Developers -> Webhooks (or `stripe listen` CLI for local dev)
# ============================================
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ============================================
# EMAIL (Nodemailer SMTP)
# YOU NEED TO DO THIS: If using Gmail, enable 2FA then create an "App Password"
# at https://myaccount.google.com/apppasswords (regular Gmail password will NOT work)
# ============================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM="Your Own Home <no-reply@yourownhome.com>"

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
